# Copy to .env. No credentials are needed for local manual learning.
PORT=3001
DEV_PORT=5173
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=data/memify.db
# Optional private service. Use the same random 32+ character secret in both repos.
CLOUD_URL=
CLOUD_SHARED_SECRET=
# Local development prints verification/reset links instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Set only behind one trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=0

# Cloudinary, for deck banner images. Uploads are signed by this server,
# so the secret must never be prefixed with VITE_ or sent to the browser.
# Leave empty to disable image uploads; decks fall back to a colour.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
